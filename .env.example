NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Calendar (Meet links) and Gmail (notifications), acting as
# englishportuguesewithtrevor@gmail.com. Leave empty to turn both off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Where emails about student bookings and cancellations go.
ADMIN_NOTIFY_EMAIL=

# Shared secret for the cron jobs (/api/cron/*) and the database's alert
# pushes (/api/alerts/push, sent as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
# Set to "on" to show the maintenance page (503) on every page during an update.
MAINTENANCE_MODE=
